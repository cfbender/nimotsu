# Protects the API used by the Android app. Generate with: openssl rand -hex 32
NIMOTSU_API_TOKEN=

# Shippo live API token. Test tokens work with Shippo's SHIPPO_* test tracking numbers.
NIMOTSU_SHIPPO_API_TOKEN=

# Secret query token included in the Shippo webhook URL. Generate with: openssl rand -hex 32
NIMOTSU_SHIPPO_WEBHOOK_TOKEN=

# Optional Firebase service-account JSON used to send Android push notifications.
NIMOTSU_FIREBASE_CREDENTIALS=

# Optional Gmail discovery. Generate the encryption key with: openssl rand -base64 32
NIMOTSU_GMAIL_CLIENT_ID=
NIMOTSU_GMAIL_CLIENT_SECRET=
NIMOTSU_PUBLIC_URL=
NIMOTSU_ENCRYPTION_KEY=

# Production defaults; Compose overrides the data and web paths.
NIMOTSU_LISTEN=:8080
NIMOTSU_DATA_PATH=./data/nimotsu.db
NIMOTSU_WEB_DIR=./web/dist
