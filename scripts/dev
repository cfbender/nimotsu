#!/usr/bin/env bash
set -euo pipefail

mise_bin="$HOME/.local/bin/mise"
if [[ -f .env ]]; then
  nimotsu_variables=(
    NIMOTSU_API_TOKEN
    NIMOTSU_SHIPPO_API_TOKEN
    NIMOTSU_SHIPPO_WEBHOOK_TOKEN
    NIMOTSU_FIREBASE_CREDENTIALS
    NIMOTSU_GMAIL_CLIENT_ID
    NIMOTSU_GMAIL_CLIENT_SECRET
    NIMOTSU_PUBLIC_URL
    NIMOTSU_ENCRYPTION_KEY
    NIMOTSU_LISTEN
    NIMOTSU_DATA_PATH
    NIMOTSU_WEB_DIR
  )
  declare -A existing_environment=()
  for variable in "${nimotsu_variables[@]}"; do
    if [[ -v $variable ]]; then
      existing_environment["$variable"]="${!variable}"
    fi
  done
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
  for variable in "${!existing_environment[@]}"; do
    export "$variable=${existing_environment[$variable]}"
  done
fi

if [[ -z "${NIMOTSU_API_TOKEN:-}" ]]; then
  export NIMOTSU_API_TOKEN="nimotsu-dev-token"
  echo "NIMOTSU_API_TOKEN is not set; using development token 'nimotsu-dev-token' (enter it in Settings)" >&2
fi

api_port="${NIMOTSU_DEV_API_PORT:-$(python3 - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(('127.0.0.1', 0))
    print(listener.getsockname()[1])
PY
)}"

mkdir -p .amp
"$mise_bin" exec -- go build -o .amp/nimotsu-dev ./cmd/nimotsu
NIMOTSU_LISTEN="127.0.0.1:${api_port}" \
NIMOTSU_WEB_DIR="" \
  .amp/nimotsu-dev &
api_pid=$!

cleanup() {
  kill "$api_pid" 2>/dev/null || true
  wait "$api_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

NIMOTSU_DEV_API_URL="http://127.0.0.1:${api_port}" \
  "$mise_bin" exec -- aube run dev:web -- --host 0.0.0.0 --port "${PORT:-5173}"
